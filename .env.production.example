# Copy to .env.production. This file is read with --env-file AND env_file.
APP_IMAGE=your-dockerhub-user/studyorganizer:1.0.0
APP_NAME=StudyOrganizer
APP_ENV=production
APP_DEBUG=false
APP_URL=https://studyorganizer.ljupchoangelovski.com
# Generate once: printf 'base64:'; openssl rand -base64 32
# Preserve the existing APP_KEY when migrating an existing installation.
APP_KEY=

# Comma-separated proxy IPs/CIDRs; obtain them with docker network inspect.
# Native Nginx usually appears as the app network's bridge gateway.
# Docker Nginx appears as its address on web-proxy (or use that trusted subnet).
# '*' is supported only when every peer that can reach web is trusted.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studyorganizer
DB_USERNAME=studyorganizer
# Generate a separate strong password: openssl rand -hex 32
DB_PASSWORD=
DB_SSLMODE=disable

LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MATERIALS_DISK=materials_local

# Logs emails until real SMTP credentials are supplied.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@ljupchoangelovski.com
MAIL_FROM_NAME=StudyOrganizer

# Only used by docker-compose.native.yml; must match the proxy upstream.
STUDYORGANIZER_HTTP_PORT=8080
